<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bulk Apply Qualifying Rates</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

    body {
      background: #47556980;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    /* Modal - Exact layout as screenshot */
    .modal {
      background: #ffffff;
      width: 100%;
      max-width: 860px;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
      border: 1px solid #cbd5e1;
      display: flex;
      flex-direction: column;
    }

    .modal-header {
      padding: 14px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #e2e8f0;
    }
    .modal-title { font-size: 1.05rem; font-weight: 700; color: #1e293b; }
    .close-btn { border: none; background: transparent; font-size: 1.4rem; color: #64748b; cursor: pointer; }

    .modal-body {
      padding: 16px 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* 3-STEP TOP BAR */
    .controls-row {
      display: grid;
      grid-template-columns: 160px 1fr 140px;
      gap: 12px;
      align-items: flex-start;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
      position: relative;
    }

    .field-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: #334155;
    }

    select {
      width: 100%;
      background: #fff;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      padding: 7px 10px;
      font-size: 0.82rem;
      color: #334155;
      outline: none;
      height: 38px;
    }

    select:disabled {
      background: #f1f5f9;
      color: #94a3b8;
      cursor: not-allowed;
    }

    /* VENDOR INPUT BOX (Shows only count) */
    .vendor-input-box {
      height: 38px;
      background: #fff;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      padding: 0 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      user-select: none;
    }
    .vendor-input-box:focus-within, .vendor-input-box.open { border-color: #2563eb; }

    .count-text {
      font-size: 0.82rem;
      color: #1e293b;
      font-weight: 600;
    }
    .placeholder-text {
      font-size: 0.82rem;
      color: #94a3b8;
      font-weight: normal;
    }

    /* DROPDOWN PANEL */
    .dropdown-panel {
      position: absolute;
      top: calc(100% + 2px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      box-shadow: 0 6px 16px rgba(0,0,0,0.12);
      z-index: 50;
      display: none;
      flex-direction: column;
      max-height: 280px;
    }
    .dropdown-panel.open { display: flex; }

    .dropdown-search {
      width: 100%;
      padding: 7px 10px;
      border: none;
      border-bottom: 1px solid #e2e8f0;
      font-size: 0.8rem;
      outline: none;
    }

    /* QUICK SELECT BY COUNTRY STRIP */
    .country-quick-bar {
      padding: 6px 10px;
      background: #eff6ff;
      border-bottom: 1px solid #dbeafe;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .quick-label {
      font-size: 0.72rem;
      font-weight: 700;
      color: #1e40af;
      margin-right: 2px;
    }
    .country-btn {
      background: #fff;
      border: 1px solid #bfdbfe;
      border-radius: 12px;
      padding: 2px 8px;
      font-size: 0.72rem;
      font-weight: 600;
      color: #1d4ed8;
      cursor: pointer;
      transition: all 0.15s;
    }
    .country-btn:hover { background: #dbeafe; }
    .country-btn.active {
      background: #2563eb;
      color: #fff;
      border-color: #2563eb;
    }

    /* Select All Toolbar */
    .dropdown-toolbar {
      padding: 6px 10px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      font-weight: 600;
      color: #475569;
    }
    .dropdown-toolbar label {
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    .dropdown-list {
      overflow-y: auto;
      padding: 4px 0;
    }

    .dropdown-item {
      padding: 7px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      font-size: 0.8rem;
      color: #1e293b;
      user-select: none;
    }
    .dropdown-item:hover { background: #f1f5f9; }
    .dropdown-item-left {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* STATUS BADGES IN DROPDOWN */
    .badge-applied {
      background: #dcfce7;
      color: #15803d;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      white-space: nowrap;
    }
    .badge-pending {
      background: #fef3c7;
      color: #92400e;
      font-size: 0.68rem;
      font-weight: 600;
      padding: 2px 6px;
      border-radius: 4px;
      white-space: nowrap;
    }

    /* TABLE EXACTLY AS IN SCREENSHOT */
    .table-container {
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      overflow: hidden;
    }

    .table-header {
      background: #f8fafc;
      padding: 8px 12px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      font-size: 0.75rem;
      font-weight: 700;
      color: #334155;
      border-bottom: 1px solid #cbd5e1;
    }

    .table-body {
      max-height: 250px;
      overflow-y: auto;
    }

    .table-row {
      padding: 8px 12px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      border-bottom: 1px solid #e2e8f0;
    }
    .table-row:last-child { border-bottom: none; }

    .item-name { font-size: 0.82rem; font-weight: 700; color: #1e293b; }
    .item-code { font-size: 0.75rem; color: #64748b; }

    .rate-input-group {
      display: flex;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      overflow: hidden;
      width: 100%;
      max-width: 280px;
    }
    .rate-input {
      border: none;
      padding: 6px 10px;
      width: 100%;
      outline: none;
      font-size: 0.85rem;
    }
    .rate-uom {
      background: #f8fafc;
      padding: 6px 12px;
      font-size: 0.75rem;
      color: #334155;
      border-left: 1px solid #cbd5e1;
      white-space: nowrap;
    }

    /* Footer */
    .modal-footer {
      padding: 12px 20px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }
    .btn {
      padding: 7px 16px;
      border-radius: 4px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-cancel { background: #fff; border: 1px solid #cbd5e1; color: #334155; }
    .btn-apply { background: #2563eb; border: 1px solid #2563eb; color: #fff; }
  </style>
</head>
<body>

  <div class="modal">
    <!-- Header -->
    <div class="modal-header">
      <h2 class="modal-title">Bulk Apply Qualifying Rates</h2>
      <button class="close-btn">&times;</button>
    </div>

    <!-- Body -->
    <div class="modal-body">

      <!-- TOP BAR -->
      <div class="controls-row">

        <!-- 1. VENDOR TYPE -->
        <div class="field-group">
          <label class="field-label">Vendor Type</label>
          <select id="vendorTypeSelect" onchange="onVendorTypeChange()">
            <option value="local">Local Vendor</option>
            <option value="intl">International</option>
          </select>
        </div>

        <!-- 2. VENDOR NAME (Only shows count inside, clean label) -->
        <div class="field-group" id="vendorFieldWrapper">
          <label class="field-label">Select Vendor(s)</label>
          
          <div class="vendor-input-box" id="vendorInputBox" onclick="toggleDropdown()">
            <span class="placeholder-text" id="vendorDisplayCount">Select vendors...</span>
            <span style="font-size: 0.7rem; color: #64748b;">▼</span>
          </div>

          <!-- Dropdown panel with search, country-quick-select, select-all & status tags -->
          <div class="dropdown-panel" id="vendorDropdownPanel">
            <input type="text" class="dropdown-search" id="vendorSearchInput" placeholder="Search vendor..." oninput="filterVendors(this.value)" onclick="event.stopPropagation()">
            
            <!-- QUICK SELECT BY COUNTRY STRIP (International only) -->
            <div class="country-quick-bar" id="countryQuickBar" onclick="event.stopPropagation()">
              <span class="quick-label">Country:</span>
              <button type="button" class="country-btn" id="btn-USA" onclick="quickSelectCountry('USA')">🇺🇸 USA (5)</button>
              <button type="button" class="country-btn" id="btn-UK" onclick="quickSelectCountry('UK')">🇬🇧 UK (5)</button>
              <button type="button" class="country-btn" id="btn-Japan" onclick="quickSelectCountry('Japan')">🇯🇵 Japan (5)</button>
            </div>

            <!-- SELECT ALL TOOLBAR -->
            <div class="dropdown-toolbar" onclick="event.stopPropagation()">
              <label>
                <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this.checked)">
                <span>Select All</span>
              </label>
              <span id="selectedCountText" style="color: #94a3b8; font-weight: normal;">0 selected</span>
            </div>

            <!-- VENDOR LIST WITH STATUS TAGS -->
            <div class="dropdown-list" id="vendorOptionsList"></div>
          </div>
        </div>

        <!-- 3. CURRENCY -->
        <div class="field-group">
          <label class="field-label">Currency</label>
          <select id="currencySelect" disabled>
            <option value="INR">INR (₹)</option>
            <option value="USD">USD ($)</option>
            <option value="GBP">GBP (£)</option>
            <option value="JPY">JPY (¥)</option>
            <option value="EUR">EUR (€)</option>
          </select>
        </div>

      </div>

      <!-- TABLE (EXACTLY AS IN SCREENSHOT) -->
      <div class="table-container">
        <div class="table-header">
          <span>ITEM NAME &amp; CODE</span>
          <span>RATE</span>
        </div>
        <div class="table-body">

          <div class="table-row">
            <div>
              <div class="item-name">AUTOITEM12</div>
              <div class="item-code">AUTOITEM12</div>
            </div>
            <div class="rate-input-group">
              <input type="text" class="rate-input">
              <span class="rate-uom">Per Kg</span>
            </div>
          </div>

          <div class="table-row">
            <div>
              <div class="item-name">AUTOITEM13</div>
              <div class="item-code">AUTOITEM13</div>
            </div>
            <div class="rate-input-group">
              <input type="text" class="rate-input">
              <span class="rate-uom">Per Kg</span>
            </div>
          </div>

          <div class="table-row">
            <div>
              <div class="item-name">ICL - Sankari Detenoting Cord - Kelc...</div>
              <div class="item-code">Kelcord'10</div>
            </div>
            <div class="rate-input-group">
              <input type="text" class="rate-input">
              <span class="rate-uom">Per L</span>
            </div>
          </div>

          <div class="table-row">
            <div>
              <div class="item-name">iphone s1</div>
              <div class="item-code">Iphone_1</div>
            </div>
            <div class="rate-input-group">
              <input type="text" class="rate-input">
              <span class="rate-uom">Per Kg</span>
            </div>
          </div>

          <div class="table-row">
            <div>
              <div class="item-name">iphone s10</div>
              <div class="item-code">Iphone_10</div>
            </div>
            <div class="rate-input-group">
              <input type="text" class="rate-input">
              <span class="rate-uom">Per Kg</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Footer -->
    <div class="modal-footer">
      <button class="btn btn-cancel">Cancel</button>
      <button class="btn btn-apply" onclick="applyRates()">Apply</button>
    </div>
  </div>

  <script>
    // 5 Local Vendors
    const localVendors = [
      { name: "AAKAR ENGINEERS PVT", country: "India", applied: true, currency: "INR" },
      { name: "Bharat Steel Ltd", country: "India", applied: false, currency: "" },
      { name: "Gujarat Precision Cast", country: "India", applied: false, currency: "" },
      { name: "Kolkata Heavy Works", country: "India", applied: false, currency: "" },
      { name: "Chennai Fasteners", country: "India", applied: false, currency: "" }
    ];

    // 15 International Vendors (5 USA, 5 UK, 5 Japan)
    const intlVendors = [
      // 5 USA
      { name: "A M Kuchling (USA)", country: "USA", defaultCurr: "USD", applied: false, currency: "" },
      { name: "Apex Global Corp (USA)", country: "USA", defaultCurr: "USD", applied: false, currency: "" },
      { name: "Detroit Precision (USA)", country: "USA", defaultCurr: "USD", applied: false, currency: "" },
      { name: "Chicago Alloys Inc (USA)", country: "USA", defaultCurr: "USD", applied: false, currency: "" },
      { name: "Texas Industrial (USA)", country: "USA", defaultCurr: "USD", applied: false, currency: "" },
      // 5 UK
      { name: "London Tools Ltd (UK)", country: "UK", defaultCurr: "GBP", applied: true, currency: "GBP" },
      { name: "Crown Industrial (UK)", country: "UK", defaultCurr: "GBP", applied: false, currency: "" },
      { name: "Manchester Fasteners (UK)", country: "UK", defaultCurr: "GBP", applied: false, currency: "" },
      { name: "Birmingham Steel (UK)", country: "UK", defaultCurr: "GBP", applied: false, currency: "" },
      { name: "Glasgow Machinery (UK)", country: "UK", defaultCurr: "GBP", applied: false, currency: "" },
      // 5 Japan
      { name: "Tokyo Seiki (Japan)", country: "Japan", defaultCurr: "JPY", applied: false, currency: "" },
      { name: "Osaka Metal Works (Japan)", country: "Japan", defaultCurr: "JPY", applied: false, currency: "" },
      { name: "Kyoto Precision (Japan)", country: "Japan", defaultCurr: "JPY", applied: false, currency: "" },
      { name: "Nagoya Tooling (Japan)", country: "Japan", defaultCurr: "JPY", applied: false, currency: "" },
      { name: "Yokohama Parts Ltd (Japan)", country: "Japan", defaultCurr: "JPY", applied: false, currency: "" }
    ];

    let selectedVendors = new Set();

    // 1. Switch Local / International
    function onVendorTypeChange() {
      const type = document.getElementById('vendorTypeSelect').value;
      const currSelect = document.getElementById('currencySelect');
      const countryBar = document.getElementById('countryQuickBar');

      selectedVendors.clear();
      document.getElementById('vendorSearchInput').value = '';
      updateCountDisplay();

      if (type === 'local') {
        currSelect.value = 'INR';
        currSelect.disabled = true;
        countryBar.style.display = 'none'; // Hide country bar for local
      } else {
        currSelect.value = 'USD';
        currSelect.disabled = false;
        countryBar.style.display = 'flex'; // Show country bar for intl
      }

      renderVendorOptions();
    }

    // 2. Quick Select By Country Action
    function quickSelectCountry(country) {
      const countryVendors = intlVendors.filter(v => v.country === country);
      const allCountrySelected = countryVendors.every(v => selectedVendors.has(v.name));

      // Toggle selection for this country
      if (allCountrySelected) {
        countryVendors.forEach(v => selectedVendors.delete(v.name));
      } else {
        countryVendors.forEach(v => selectedVendors.add(v.name));
        
        // Auto-switch currency to match the country
        const currMap = { 'USA': 'USD', 'UK': 'GBP', 'Japan': 'JPY' };
        if (currMap[country]) {
          document.getElementById('currencySelect').value = currMap[country];
        }
      }

      updateCountryButtonHighlights();
      updateCountDisplay();
      renderVendorOptions(document.getElementById('vendorSearchInput').value);
    }

    // Highlight active country buttons if all their vendors are selected
    function updateCountryButtonHighlights() {
      ['USA', 'UK', 'Japan'].forEach(c => {
        const btn = document.getElementById(`btn-${c}`);
        if (!btn) return;
        const cVendors = intlVendors.filter(v => v.country === c);
        const isAll = cVendors.length > 0 && cVendors.every(v => selectedVendors.has(v.name));
        btn.classList.toggle('active', isAll);
      });
    }

    // 3. Render Dropdown Options with Status Badges
    function renderVendorOptions(filterText = '') {
      const type = document.getElementById('vendorTypeSelect').value;
      const list = type === 'local' ? localVendors : intlVendors;
      const container = document.getElementById('vendorOptionsList');
      container.innerHTML = '';

      const filtered = list.filter(v => v.name.toLowerCase().includes(filterText.toLowerCase()));

      filtered.forEach(v => {
        const isChecked = selectedVendors.has(v.name) ? 'checked' : '';
        const item = document.createElement('label');
        item.className = 'dropdown-item';
        item.onclick = (e) => e.stopPropagation();

        const badge = v.applied 
          ? `<span class="badge-applied">✓ Applied (${v.currency})</span>` 
          : `<span class="badge-pending">Pending</span>`;

        item.innerHTML = `
          <div class="dropdown-item-left">
            <input type="checkbox" ${isChecked} onchange="toggleVendorSelection('${v.name}', this.checked)">
            <span>${v.name}</span>
          </div>
          ${badge}
        `;
        container.appendChild(item);
      });

      // Update Select All Checkbox state
      const selectAll = document.getElementById('selectAllCheckbox');
      selectAll.checked = filtered.length > 0 && filtered.every(v => selectedVendors.has(v.name));
      document.getElementById('selectedCountText').textContent = `${selectedVendors.size} selected`;
      updateCountryButtonHighlights();
    }

    // 4. Toggle Select All
    function toggleSelectAll(isChecked) {
      const type = document.getElementById('vendorTypeSelect').value;
      const list = type === 'local' ? localVendors : intlVendors;
      const filterText = document.getElementById('vendorSearchInput').value.toLowerCase();
      const filtered = list.filter(v => v.name.toLowerCase().includes(filterText));

      filtered.forEach(v => {
        if (isChecked) {
          selectedVendors.add(v.name);
        } else {
          selectedVendors.delete(v.name);
        }
      });

      updateCountDisplay();
      renderVendorOptions(filterText);
    }

    // 5. Toggle Individual Vendor Selection
    function toggleVendorSelection(name, isChecked) {
      if (isChecked) {
        selectedVendors.add(name);
      } else {
        selectedVendors.delete(name);
      }
      updateCountDisplay();

      const type = document.getElementById('vendorTypeSelect').value;
      const list = type === 'local' ? localVendors : intlVendors;
      const filterText = document.getElementById('vendorSearchInput').value.toLowerCase();
      const filtered = list.filter(v => v.name.toLowerCase().includes(filterText));
      document.getElementById('selectAllCheckbox').checked = filtered.length > 0 && filtered.every(v => selectedVendors.has(v.name));
      document.getElementById('selectedCountText').textContent = `${selectedVendors.size} selected`;
      updateCountryButtonHighlights();
    }

    // 6. Update Count in the Input Bar
    function updateCountDisplay() {
      const display = document.getElementById('vendorDisplayCount');
      const count = selectedVendors.size;

      if (count === 0) {
        display.className = 'placeholder-text';
        display.textContent = 'Select vendors...';
      } else {
        display.className = 'count-text';
        display.textContent = `${count} Vendor${count > 1 ? 's' : ''} Selected`;
      }
    }

    function filterVendors(query) {
      renderVendorOptions(query);
    }

    function toggleDropdown() {
      const panel = document.getElementById('vendorDropdownPanel');
      panel.classList.toggle('open');
      document.getElementById('vendorInputBox').classList.toggle('open', panel.classList.contains('open'));
    }

    document.addEventListener('click', function(e) {
      if (!e.target.closest('#vendorFieldWrapper')) {
        document.getElementById('vendorDropdownPanel').classList.remove('open');
        document.getElementById('vendorInputBox').classList.remove('open');
      }
    });

    // 7. Apply Rates Action
    function applyRates() {
      if (selectedVendors.size === 0) {
        alert('Please select at least one vendor.');
        return;
      }

      const type = document.getElementById('vendorTypeSelect').value;
      const currency = document.getElementById('currencySelect').value;
      const list = type === 'local' ? localVendors : intlVendors;

      list.forEach(v => {
        if (selectedVendors.has(v.name)) {
          v.applied = true;
          v.currency = currency;
        }
      });

      renderVendorOptions(document.getElementById('vendorSearchInput').value);
      alert(`Success! Rates applied to ${selectedVendors.size} vendor(s) in ${currency}.`);
    }

    // Initial load
    onVendorTypeChange();
  </script>

</body>
</html>
